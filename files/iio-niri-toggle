#!/bin/bash
# iio-niri-toggle — Screen rotation daemon & IPC client
# Daemon:  iio-niri-toggle daemon     (systemd service)
# Client:  iio-niri-toggle send <cmd> (QML plugin / CLI)
# Commands: lock, unlock, status, toggle
set -euo pipefail

readonly NAME="iio-niri-toggle"
STATE_DIR="${STATE_DIR:-/var/lib/iio-niri-toggle}"
STATE_FILE="$STATE_DIR/state.json"
IPC_SOCK="/var/run/iio-niri-toggle.sock"

die() { echo "$NAME: $*" >&2; exit 1; }
warn() { echo "$NAME: $*" >&2; }

# ── monitor detection ─────────────────────────────────────────────────────

detect_monitor() {
    local c name status
    for c in /sys/class/drm/card*-*/; do
        status=$(cat "$c/status" 2>/dev/null) || continue
        [ "$status" = "connected" ] || continue
        name=$(basename "$c")
        if [[ "$name" =~ ^card[0-9]+-(eDP|DSI)- ]]; then
            echo "${name#card[0-9]*-}"
            return 0
        fi
    done
    return 1
}

# ── state helpers ──────────────────────────────────────────────────────────

read_json_field() {
    local file="$1" field="$2"
    python3 -c "
import json
try:
    with open('$file') as f:
        d = json.load(f)
    v = d.get('$field')
    if v is None:
        print('null')
    elif isinstance(v, bool):
        print('true' if v else 'false')
    else:
        print(v)
except Exception:
    print('null')
"
}

write_state() {
    local auto_rotate="$1" locked_transform="$2" monitor="$3"
    mkdir -p "$STATE_DIR"
    python3 -c "
import json
auto = '$auto_rotate'
locked = None if '$locked_transform' == 'None' else '$locked_transform'
d = {'auto_rotate': auto == 'True', 'locked_transform': locked, 'monitor': '$monitor'}
with open('$STATE_FILE', 'w') as f:
    json.dump(d, f)
    f.write(chr(10))
"
    chmod 644 "$STATE_FILE" 2>/dev/null || true
}

# ── orientation helpers (daemon-internal) ───────────────────────────────────

_IIO_SOCK=""
_IIO_PID=""

# Query current output transform from niri directly (more reliable)
_iio_current_transform() {
    niri msg --json outputs 2>/dev/null | python3 -c "
import json, sys
try:
    d = json.load(sys.stdin)
    o = d.get('eDP-1', {})
    t = o.get('logical', {}).get('transform', 'normal')
    # Normalize: niri returns \"Normal\" but expects \"normal\" as input
    lc = t.lower()
    print(lc)
except:
    sys.exit(1)
" 2>/dev/null
}

# ── daemon internals ────────────────────────────────────────────────────────

_daemon_start_iio() {
    local monitor="$1"
    _IIO_SOCK="${XDG_RUNTIME_DIR}/iio-niri.sock"
    rm -f "$_IIO_SOCK" 2>/dev/null || true
    iio-niri -s "$_IIO_SOCK" listen -m "$monitor" &
    _IIO_PID=$!
    disown 2>/dev/null || true
    local i=0
    while [ $i -lt 30 ]; do
        [ -S "$_IIO_SOCK" ] && return 0
        sleep 0.1
        i=$((i + 1))
    done
    return 1
}

_daemon_apply_lock() {
    local auto monitor
    auto=$(read_json_field "$STATE_FILE" auto_rotate)

    monitor=$(read_json_field "$STATE_FILE" monitor)
    if [ "$monitor" = "null" ] || [ -z "$monitor" ]; then
        monitor=$(detect_monitor 2>/dev/null || true)
        [ -z "$monitor" ] && monitor="eDP-1"
    fi

    if [ "$auto" = "true" ]; then
        [ -n "$_IIO_PID" ] && [ -S "$_IIO_SOCK" ] && \
            iio-niri -s "$_IIO_SOCK" msg lock-rotation false 2>/dev/null || true
        echo "$NAME: auto-rotate on $monitor"
    else
        # Capture current orientation so it persists across sessions
        local transform
        transform=$(read_json_field "$STATE_FILE" locked_transform)
        if [ "$transform" = "null" ] || [ -z "$transform" ]; then
            transform=$(_iio_current_transform 2>/dev/null || echo "normal")
            write_state False "$transform" "$monitor"
        fi
        [ -n "$_IIO_PID" ] && [ -S "$_IIO_SOCK" ] && \
            iio-niri -s "$_IIO_SOCK" msg lock-rotation true 2>/dev/null || true
        echo "$NAME: rotation locked on $monitor"
    fi
}

_daemon_start_iio_and_apply() {
    local monitor
    monitor=$(read_json_field "$STATE_FILE" monitor)
    if [ "$monitor" = "null" ] || [ -z "$monitor" ]; then
        monitor=$(detect_monitor 2>/dev/null || true)
        [ -z "$monitor" ] && monitor="eDP-1"
    fi

    # Pre-set transform BEFORE starting iio-niri, so the screen shows
    # correct orientation immediately (no wait for sensor data).
    local auto transform
    auto=$(read_json_field "$STATE_FILE" auto_rotate)
    if [ "$auto" = "false" ]; then
        transform=$(read_json_field "$STATE_FILE" locked_transform)
        if [ "$transform" = "null" ] || [ -z "$transform" ]; then
            transform=$(_iio_current_transform 2>/dev/null || echo "normal")
            write_state False "$transform" "$monitor"
        fi
        niri msg output "$monitor" transform "$transform" 2>/dev/null || true
    fi

    if [ -z "${_IIO_PID:-}" ] || ! kill -0 "$_IIO_PID" 2>/dev/null; then
        # Brief delay when restarting after a session transition,
        # letting D-Bus clean up the old iio-niri's connection.
        [ -n "${_IIO_PID:-}" ] && sleep 2
        _daemon_start_iio "$monitor"
    fi
    _daemon_apply_lock
}

_niri_alive() {
    [ -n "${NIRI_SOCKET:-}" ] && [ -S "$NIRI_SOCKET" ] && niri msg --json outputs &>/dev/null
}

_daemon_kill_iio() {
    [ -n "${_IIO_PID:-}" ] && kill "$_IIO_PID" 2>/dev/null || true
    wait "$_IIO_PID" 2>/dev/null || true
    _IIO_PID=""
    rm -f "$_IIO_SOCK" 2>/dev/null || true
    _IIO_SOCK=""
}

_export_session_env() {
    local sock_path="$1"
    local uid display
    uid=$(echo "$sock_path" | cut -d/ -f4)
    display=$(basename "$sock_path" | cut -d. -f2-3)
    export XDG_RUNTIME_DIR="/run/user/$uid"
    export WAYLAND_DISPLAY="$display"
}

_wait_for_sock() {
    _found_sock=""
    while true; do
        _found_sock=$(find /run/user/ -maxdepth 3 -name "niri*.sock" -type s 2>/dev/null | head -1) || true
        [ -n "$_found_sock" ] && return 0
        sleep 1
    done
}

# ── IPC socket listener (background Python process) ────────────────────────

_daemon_start_ipc() {
    python3 -c "
import json, os, socket, sys

SOCK = '$IPC_SOCK'
STATE = '$STATE_FILE'

try:
    os.unlink(SOCK)
except FileNotFoundError:
    pass

sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
sock.bind(SOCK)
os.chmod(SOCK, 0o666)
sock.listen(5)

while True:
    conn, _ = sock.accept()
    data = conn.recv(4096)
    if not data:
        conn.close()
        continue
    try:
        req = json.loads(data.decode())
        cmd = req.get('command', '')
    except (json.JSONDecodeError, UnicodeDecodeError):
        conn.close()
        continue

    if cmd == 'lock':
        try:
            with open(STATE) as f:
                d = json.load(f)
            d['auto_rotate'] = False
            d['locked_transform'] = None  # daemon fills real transform
            with open(STATE, 'w') as f:
                json.dump(d, f)
                f.write(chr(10))
            resp = {'ok': True, 'auto_rotate': False}
        except Exception as e:
            resp = {'ok': False, 'error': str(e)}

    elif cmd == 'unlock':
        try:
            with open(STATE) as f:
                d = json.load(f)
            d['auto_rotate'] = True
            d['locked_transform'] = None
            with open(STATE, 'w') as f:
                json.dump(d, f)
                f.write(chr(10))
            resp = {'ok': True, 'auto_rotate': True}
        except Exception as e:
            resp = {'ok': False, 'error': str(e)}

    elif cmd == 'status':
        try:
            with open(STATE) as f:
                d = json.load(f)
            resp = {'ok': True, 'state': d}
        except:
            resp = {'ok': True, 'state': {'auto_rotate': True, 'locked_transform': None, 'monitor': 'eDP-1'}}

    else:
        resp = {'ok': False, 'error': 'unknown command: ' + cmd}

    try:
        conn.sendall((json.dumps(resp) + chr(10)).encode())
    except:
        pass
    conn.close()
" &
    _IPC_PID=$!
    disown 2>/dev/null || true
    # Wait for socket to appear
    local i=0
    while [ $i -lt 20 ]; do
        [ -S "$IPC_SOCK" ] && return 0
        sleep 0.1
        i=$((i + 1))
    done
    return 1
}

_daemon_kill_ipc() {
    [ -n "${_IPC_PID:-}" ] && kill "$_IPC_PID" 2>/dev/null || true
    wait "$_IPC_PID" 2>/dev/null || true
    _IPC_PID=""
    rm -f "$IPC_SOCK" 2>/dev/null || true
}

# ── client subcommand ──────────────────────────────────────────────────────

cmd_send() {
    local cmd="${1:-}"
    [ -z "$cmd" ] && die "usage: $NAME send <lock|unlock|status|toggle>"

    if [ "$cmd" = "toggle" ]; then
        # Toggle is client-side logic: read state via socket, invert
        local result
        result=$(echo '{"command":"status"}' | socat - UNIX-CONNECT:"$IPC_SOCK" 2>/dev/null) || \
            die "cannot connect to daemon (is iio-niri-toggle running?)"
        local auto
        auto=$(echo "$result" | python3 -c "import json,sys; print(json.load(sys.stdin)['state']['auto_rotate'])" 2>/dev/null)
        if [ "$auto" = "True" ]; then
            cmd="lock"
        else
            cmd="unlock"
        fi
    fi

    local payload
    payload=$(printf '{"command":"%s"}' "$cmd")
    echo "$payload" | socat - UNIX-CONNECT:"$IPC_SOCK" 2>/dev/null || \
        die "cannot connect to daemon (is iio-niri-toggle running?)"
}

# ── user-facing aliases (compat) ────────────────────────────────────────────

cmd_lock()   { cmd_send lock; }
cmd_unlock() { cmd_send unlock; }
cmd_status() { cmd_send status; }

# ── daemon ──────────────────────────────────────────────────────────────────

cmd_daemon() {
    set +e
    # Init state
    mkdir -p "$STATE_DIR"
    if [ ! -f "$STATE_FILE" ]; then
        local mon
        mon=$(detect_monitor 2>/dev/null || true) || mon="eDP-1"
        write_state True None "$mon"
    fi
    chmod 644 "$STATE_FILE" 2>/dev/null || true

    echo "$NAME: daemon started"

    while true; do
        # Start IPC listener
        _daemon_start_ipc
        echo "$NAME: IPC socket at $IPC_SOCK"

        # Phase 1: wait for niri
        _wait_for_sock
        export NIRI_SOCKET="$_found_sock"
        _export_session_env "$_found_sock"
        echo "$NAME: niri active at $NIRI_SOCKET"
        _daemon_start_iio_and_apply

        # Phase 2: monitor until niri exits
        while _niri_alive; do
            inotifywait -q -e close_write "$STATE_FILE" \
                -e delete_self "$NIRI_SOCKET" &>/dev/null
            local rc=$?
            if [ $rc -eq 0 ]; then
                echo "$NAME: state changed, updating rotation"
                _daemon_apply_lock
            fi

            # Check iio-niri health after every wakeup
            if [ -n "${_IIO_PID:-}" ] && ! kill -0 "$_IIO_PID" 2>/dev/null; then
                wait "$_IIO_PID" 2>/dev/null || true
                echo "$NAME: iio-niri exited, re-starting"
                _daemon_start_iio_and_apply
            fi
        done

        _daemon_kill_iio
        unset NIRI_SOCKET
        echo "$NAME: niri disconnected, awaiting next session..."
    done
}

# ── dispatch ────────────────────────────────────────────────────────────────

case "${1:-}" in
    daemon)  cmd_daemon  ;;
    send)    cmd_send "${2:-}" ;;
    lock)    cmd_send lock ;;
    unlock)  cmd_send unlock ;;
    status)  cmd_send status ;;
    *)
        echo "Usage: $NAME {daemon|send <cmd>|lock|unlock|status}" >&2
        echo "  Commands: lock, unlock, status, toggle" >&2
        exit 1
        ;;
esac
