[Unit]
Description=IIO Niri Toggle Daemon
After=iio-sensor-proxy.service
Before=greetd.service

[Service]
Type=simple
ExecStart=/usr/local/bin/iio-niri-toggle daemon
Restart=on-failure
StateDirectory=iio-niri-toggle

# ── Sandbox hardening ──────────────────────────────────────────────────────
# The daemon must run as root (cross-user niri IPC via /run/user/<uid>, which
# is 0700 and only root can enter), so this shrinks its damage radius instead:
#   * /run must stay writable (IPC socket bind + niri socket connect) →
#     ProtectSystem=yes, NOT =strict (strict remounts /run read-only, which
#     breaks both — verified empirically)
#   * /run/user must stay reachable (niri socket discovery) → no ProtectHome
#     (ProtectHome=true makes /run/user inaccessible — verified empirically)
#   * capabilities are stripped to the two DAC caps actually required:
#     CAP_DAC_READ_SEARCH → traverse/read 0700 /run/user/<uid> for socket discovery
#     CAP_DAC_OVERRIDE    → connect to the niri socket inside it (MAY_WRITE check)
#     Everything else (bind /var/run socket, write /var/lib, D-Bus, inotify,
#     sysfs) works as the directory/file owner (uid 0) with no capabilities.
ProtectSystem=yes
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
NoNewPrivileges=true
RestrictSUIDSGID=true
RestrictNamespaces=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_NETLINK
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH
MemoryDenyWriteExecute=true
Environment=PATH=/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=multi-user.target
